# TimeSyncBot Environment Configuration
# Copy this file to .env and fill in your values: cp .env.example .env

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin Telegram IDs (comma-separated integers)
ADMIN_IDS=1234567890

# Timezone (Europe/Moscow recommended for VyatSU)
TZ=Europe/Moscow

# Storage Directories (defaults to ./data and ./logs)
DATA_DIR=./data
DB_DIR=./data
LOG_DIR=./logs

# Databases
DB_NAME=piculi.db
ANALYTICS_DB_NAME=analytics.db

# REST API Server (for Android Widget)
API_HOST=0.0.0.0
API_PORT=8000
