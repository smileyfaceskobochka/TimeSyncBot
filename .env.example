# TimeSync Environment Configuration
# Copy this file to .env and fill in your values: cp .env.example .env
#
# Architecture: ONE image, TWO roles.
#   timesync-server — FastAPI server: owns the SQLite DB, parser and scheduler.
#                     Serves /api/v1 (public) and /api/v1/internal (bot client).
#   timesync-bot    — Telegram bot client: talks to the server over HTTP.

# ─── Shared ───
# Timezone (Europe/Moscow recommended for VyatSU). Applies to schedules,
# digests and all parser jobs — fixes the "digest arrives at ~00:00" bug.
TZ=Europe/Moscow

# Shared secret for the internal bot<->server API (X-API-Key header).
# Generate one: python -c "import secrets; print(secrets.token_hex(24))"
BOT_API_KEY=change_me_shared_secret

# Storage Directories (defaults to ./data and ./logs)
DATA_DIR=./data
DB_DIR=./data
LOG_DIR=./logs

# Databases
DB_NAME=piculi.db
ANALYTICS_DB_NAME=analytics.db

# ─── Server (timesync-server) ───
API_HOST=0.0.0.0
API_PORT=8000

# Optional: comma-separated API keys for the PUBLIC /api/v1 API
# (used by external clients such as the Android widget). Leave empty to disable.
# Note: BOT_API_KEY is always accepted as a valid key on protected endpoints.
API_KEYS=

# ─── Bot client (timesync-bot) ───
# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin Telegram IDs (comma-separated integers)
ADMIN_IDS=1234567890

# Base URL of the core server. In docker-compose (host networking) the
# default works; for a remote server use e.g. http://server-host:8000
SERVER_URL=http://localhost:8000
